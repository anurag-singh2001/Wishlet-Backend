# Wishlet Backend Environment Variables

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wishlet?schema=public"

# CORS
CORS_ORIGIN=http://localhost:3000

# Cloudinary User Photo Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

