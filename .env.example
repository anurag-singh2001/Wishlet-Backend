# Wishlet Backend Environment Variables

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wishlet?schema=public"

# CORS — comma-separated origins, or * for all
CORS_ORIGIN=http://localhost:3000

# Optional: suffix of this project's own Vercel preview URLs allowed by CORS (e.g. -yourteam.vercel.app)
CORS_PREVIEW_SUFFIX=

# Frontend URL — used for generating public wish URLs
FRONTEND_URL=http://localhost:3000

# Cloudinary User Photo Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Hours until a wish link expires and is deleted (default 24)
WISH_TTL_HOURS=24

# Secret salt for hashing anonymous reaction voter ids (set a long random string in production)
REACTION_SALT=change_me
